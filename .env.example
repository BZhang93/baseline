# Baseline — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# (In Supabase: Project Settings → Data API / Database.)
#
# NEVER commit the real `.env`. Only this `.env.example` is tracked.

# --- Supabase Auth (used by the app in the browser + server) ---
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# --- Database (used by Prisma) ---
# Project Settings → Database → Connection string.
# DATABASE_URL = the *pooled* "Transaction" connection (port 6543). Used at runtime.
# DIRECT_URL   = the *direct* "Session" connection (port 5432). Used for migrations.
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
